# TMDB
TMDB_ACCESS_TOKEN=
API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin = Supabase Auth хэрэглэгч + profiles.role='admin' (supabase/migrations_002_auth_premium.sql үз)

# Wire (app.wire.mn) – QPay төлбөр. Dashboard → API keys / Webhooks
WIRE_SECRET_KEY=            # sk_live_...
WIRE_WEBHOOK_SECRET=        # Webhook endpoint үүсгэхэд ганц удаа харагдана
WIRE_OPERATORS=             # заавал биш, таслалаар (хоосон = project дээр идэвхтэй бүх operator)
NEXT_PUBLIC_SITE_URL=       # https://yourdomain.com
PREMIUM_PRICE_MONTH=9900    # ₮
PREMIUM_PRICE_YEAR=99000    # ₮

# Cloudflare R2 (видео + poster/backdrop зураг)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_IMAGES_PUBLIC_URL=   # poster/backdrop-ийн PUBLIC хаяг (заавал public байх ёстой). Хоосон бол R2_PUBLIC_URL ашиглана
R2_PUBLIC_URL=   # жишээ: https://cdn.yourdomain.com (custom domain) эсвэл https://pub-xxxx.r2.dev

# Gemini (AI facts / suggestions)
GEMINI_API_KEY=
# Таслалаар тусгаарласан зөвшөөрөгдсөн origin-ууд (production-д заавал)
ALLOWED_ORIGINS=

# Rate limit-ийг instance хооронд хуваалцах (заавал биш, Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
